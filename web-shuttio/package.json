{
  "name": "web-shuttio",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=26.12.1"
  },
  "scripts": {
    "dev": "vite dev --port 3000",
    "build": "vite build",
    "preview": "vite preview",
    "generate-routes": "tsr generate",
    "lint": "eslint",
    "typecheck": "pnpm i18n && tsr generate && tsc --noEmit",
    "test": "vitest run",
    "format": "prettier --write .",
    "i18n": "paraglide-js compile --project ./project.inlang --outdir ./src/paraglide --strategy baseLocale",
    "check:state": "! grep -rn \"invalidateQueries()\" src --include=*.ts --include=*.tsx"
  },
