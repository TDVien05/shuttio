# Copy to `.env.local` and adjust.

# Browser-facing origin of the NestJS api. Must be reachable from the browser
# (the api's WEB_URL must list this app's origin for CORS).
VITE_API_URL=http://localhost:6969

# Centrifugo WebSocket endpoint (realtime: rooms, sessions, notifications).
VITE_CENTRIFUGO_URL=ws://localhost:8000/connection/websocket

# Clerk publishable key — from the Clerk dashboard (API Keys).
VITE_CLERK_PUBLISHABLE_KEY=

# Mapbox token for the Find Courts map view. Optional — without it the map
# panel shows a "set this token" fallback instead of the interactive map.
VITE_MAPBOX_TOKEN=

# Cloudinary cloud name for image delivery (the public name, not an API key).
VITE_CLOUDINARY_CLOUD_NAME=
